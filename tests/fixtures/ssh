#!/bin/sh
# fake ssh fixture.
#
# A stub for testing daemon/muxclient (and later hostsession) without a real
# SSH server. Place this script at the front of `PATH` so powarder picks it
# up as `ssh`. Behavior is switched via the POWARDER_FAKE_SSH_MODE
# environment variable.
#
# The output wording reproduces real, measured OpenSSH output verbatim (the
# same wording used in core/muxparse.nim's tests). Changing the wording will
# break muxparse's parsing as-is, so if you change it, be sure to check
# consistency with the measured data in core/muxparse.nim / tests/tmuxparse.nim.

mode="${POWARDER_FAKE_SSH_MODE:-ok}"
orig_args="$*"

# --- Argument logging -------------------------------------------------------
# If POWARDER_FAKE_SSH_LOG is set, append all received arguments as one line.
# Arguments are separated with the ASCII unit separator (0x1F). Space-
# separated would make argument boundaries ambiguous when a hostname or path
# contains a space (the quoteShell test case), so this lets the test side
# reconstruct argv exactly.
if [ -n "$POWARDER_FAKE_SSH_LOG" ]; then
  logline=""
  first=1
  for arg in "$@"; do
    if [ "$first" -eq 1 ]; then
      logline="$arg"
      first=0
    else
      logline="$logline$(printf '\037')$arg"
    fi
  done
  printf '%s\n' "$logline" >> "$POWARDER_FAKE_SSH_LOG"
fi

# --- Argument parsing --------------------------------------------------------
is_master=0
is_config=0
action=""
ctl_path=""
host=""

while [ $# -gt 0 ]; do
  case "$1" in
    -M)
      is_master=1
      shift
      ;;
    -G)
      is_config=1
      shift
      ;;
    -N | -v)
      shift
      ;;
    -S)
      ctl_path="$2"
      shift 2
      ;;
    -O)
      action="$2"
      shift 2
      ;;
    -o)
      # Skip -o Key=Value (the value itself doesn't affect fake ssh's behavior)
      shift 2
      ;;
    -L | -R)
      # forward/cancel spec argument. fake ssh's behavior doesn't depend on
      # the spec's contents, so discard the value (logging is handled via
      # POWARDER_FAKE_SSH_LOG).
      shift 2
      ;;
    -*)
      shift
      ;;
    *)
      if [ -z "$host" ]; then
        host="$1"
      fi
      shift
      ;;
  esac
done

# --- no-master: treat every -O subcommand as unable to reach the control socket ----
if [ -n "$action" ] && [ "$mode" = "no-master" ]; then
  printf 'Control socket connect(%s): No such file or directory\n' "$ctl_path" >&2
  exit 255
fi

# --- -M -N: ControlMaster startup mode ---------------------------------------
if [ "$is_master" -eq 1 ]; then
  case "$mode" in
    auth-failed)
      # Authentication failure. Fail immediately without creating the
      # control socket (no sleep).
      printf '%s: Permission denied (publickey).\n' "$host" >&2
      exit 255
      ;;
    slow-start)
      # For readiness-polling tests, wait 3 seconds before creating the
      # control socket.
      sleep 3
      ;;
  esac

  # Actually create the control socket (UDS). To make readiness detection
  # via `socketExists()` behave the same as with the real thing, this must
  # be a real UDS, not just a plain file.
  #
  # **The tool available to create a UDS differs by environment.** Measured:
  #   - macOS: `nc` (BSD netcat, has `-U`)
  #   - nimlang/nim:2.2.10 (Debian trixie): no nc / socat / python3, **only perl**
  #   - GitHub Actions ubuntu: `nc` (netcat-openbsd)
  # Betting on a single tool breaks a large number of tests the moment the
  # environment changes (in fact, 4 tests in `tdaemon.nim` failed on
  # Debian), so this falls back through whichever tool is usable, trying
  # each in turn.
  #
  # Grepping `nc -h` output to determine whether an option exists is
  # unreliable across netcat implementation differences (traditional /
  # openbsd / BSD), so acceptance is decided by **actually starting it and
  # checking whether the socket appears**.
  # IMPORTANT: always close inherited extra fds before exec'ing the listener.
  #
  # powarder's test binary launches fake ssh via `startProcess`, but
  # `std/osproc` **always creates pipes for stdin/stdout/stderr** unless
  # `poParentStreams` is given (confirmed by measurement). Those pipe fds
  # are inherited by fake ssh, and then by its child, the listener. The
  # listener is long-lived, so if it's left running, **the parent (test
  # binary -> nimble) will hang forever waiting for that pipe's EOF**
  # (confirmed: `nimble test` hung for 3 hours in a Linux container. The
  # orphaned listener's fds `3,5,8,9,10,12 -> pipe:[...]` remained, and the
  # pipe that `nimble` was reading from never closed).
  #
  # IMPORTANT: **do not close fd 3 and above here.** Two approaches were
  # tried and both broke things:
  #   (1) Unconditionally apply `exec N>&-` across 3..63
  #       -> `dash` (Debian / Ubuntu's /bin/sh) treats a redirect to an
  #          unopened fd as an error and **terminates the non-interactive
  #          shell immediately** (macOS's bash silently allows it).
  #          `2>/dev/null || true` can't suppress it (the shell itself
  #          dies).
  #   (2) Check existence with `[ -e /dev/fd/N ]` before closing
  #       -> if the parent has already initialized asyncdispatch (holding
  #          epoll / socket fds), the listener startup itself breaks.
  #          Confirmed with a minimal repro: without asyncdispatch,
  #          hsConnected appears at tick 1; with it, we get
  #          "fake ssh: no tool available to create a UDS".
  #
  # So fds are only redirected for 0/1/2, and **hangs are prevented instead
  # by reliably cleaning up the listener tied to the runtime dir at the end
  # of each test** (see the pkill at the end of each test file). If no
  # listener is left behind, the pipe closes too.
  _spawn_listener() {
    exec "$@" </dev/null >/dev/null 2>&1
  }

  rm -f "$ctl_path"
  nc_pid=""
  for _uds_tool in nc python3 perl; do
    command -v "$_uds_tool" >/dev/null 2>&1 || continue
    case "$_uds_tool" in
      nc)
        ( _spawn_listener nc -lkU "$ctl_path" ) &
        ;;
      python3)
        ( _spawn_listener python3 -c 'import socket, sys, time
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.bind(sys.argv[1])
s.listen(5)
while True:
    time.sleep(3600)' "$ctl_path" ) &
        ;;
      perl)
        ( _spawn_listener perl -e 'use IO::Socket::UNIX;
my $p = shift;
IO::Socket::UNIX->new(Local => $p, Listen => 5) or die "bind failed: $!";
while (1) { sleep 3600; }' "$ctl_path" ) &
        ;;
    esac
    _uds_pid=$!
    _i=0
    while [ ! -S "$ctl_path" ] && [ "$_i" -lt 40 ] && kill -0 "$_uds_pid" 2>/dev/null; do
      sleep 0.05
      _i=$((_i + 1))
    done
    if [ -S "$ctl_path" ]; then
      nc_pid=$_uds_pid
      break
    fi
    kill "$_uds_pid" 2>/dev/null
    rm -f "$ctl_path"
  done

  if [ -z "$nc_pid" ]; then
    echo "fake ssh: no tool available to create a UDS" >&2
    echo "fake ssh: requires one of nc -U / python3 / perl" >&2
    exit 1
  fi

  # For the M6 orphan-adopt test: record the real master's (this script's
  # own) pid next to ctl_path. `-O check` reads and returns this (falling
  # back to `$$` if absent; see the `check)` branch below). Without this,
  # `-O check`'s pid would be the short-lived pid of the check invocation
  # itself, and the adopt logic's liveness check / cmdline matching would
  # break by disagreeing with the real master's pid.
  echo "$$" > "${ctl_path}.pid"

  cleanup() {
    kill "$nc_pid" 2>/dev/null
    # **Actually wait for the listener to finish.** If we exit right after
    # sending kill, the parent shell disappears first, the listener becomes
    # an orphan (PPID=1), and it keeps running after the test ends
    # (measured: 5 leftover nc processes remained for over 9 minutes after
    # the torphan test).
    wait "$nc_pid" 2>/dev/null
    rm -f "$ctl_path" "${ctl_path}.pid"
  }
  trap 'cleanup; exit 0' TERM INT

  # Use `wait` (rather than polling with `while kill -0 + sleep`).
  # POSIX sh's `wait` is interrupted by a signal, so the trap fires reliably
  # and immediately, without burning CPU while waiting. With polling, the
  # trap would fire late by up to `sleep`'s granularity, and if the parent
  # exits during that window the listener would be left behind.
  wait "$nc_pid" 2>/dev/null
  cleanup
  exit 0
fi

# --- -G: ssh_config resolution mode -------------------------------------------
if [ "$is_config" -eq 1 ]; then
  # Measured: OpenSSH can emit a pseudo-terminal warning to stderr when run
  # from a non-interactive terminal. core/sshgparse.parseSshG's contract is
  # to look only at stdout, so this is always emitted here too, to let
  # tests verify that contract is honored.
  printf 'Pseudo-terminal will not be allocated because stdin is not a terminal.\n' >&2
  cat <<EOF
host $host
hostname $host
user fakeuser
port 22
addressfamily any
batchmode no
canonicalizehostname false
challengeresponseauthentication yes
checkhostip no
compression no
connectionattempts 1
connecttimeout none
controlmaster false
controlpersist no
enablesshkeysign no
forwardagent no
forwardx11 no
gatewayports no
hashknownhosts no
hostbasedauthentication no
identitiesonly no
identityfile ~/.ssh/id_rsa
identityfile ~/.ssh/id_ecdsa
kbdinteractiveauthentication yes
nohostauthenticationforlocalhost no
passwordauthentication yes
permitlocalcommand no
protocol 2
proxycommand none
pubkeyauthentication yes
serveraliveinterval 0
serveralivecountmax 3
stricthostkeychecking ask
tcpkeepalive yes
userknownhostsfile ~/.ssh/known_hosts
verifyhostkeydns false
visualhostkey no
EOF
  exit 0
fi

# --- -O check / forward / cancel / exit --------------------------------------
case "$action" in
  check)
    # If the real master's pid was recorded, return it (written to
    # `${ctl_path}.pid` by the `-M -N` branch). If not (i.e. a caller that
    # never started a master, such as tmuxclient.nim's unit tests), fall
    # back to this process's own pid.
    if [ -f "${ctl_path}.pid" ]; then
      real_pid=$(cat "${ctl_path}.pid")
    else
      real_pid="$$"
    fi
    printf 'Master running (pid=%s)\r\n' "$real_pid" >&2
    exit 0
    ;;
  forward)
    case "$mode" in
      bind-failed)
        printf 'mux_client_forward: forwarding request failed: Port forwarding failed\n' >&2
        printf 'muxclient: master forward request failed\n' >&2
        exit 255
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
  cancel)
    case "$mode" in
      not-forwarded)
        printf 'mux_client_forward: forwarding request failed: port not forwarded\n' >&2
        printf 'muxclient: master cancel forward request failed\n' >&2
        exit 0
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
  exit)
    exit 0
    ;;
  *)
    # Reaching here means an unexpected invocation. Fail explicitly instead
    # of silently treating it as success, so tests can notice.
    printf 'fake ssh: unrecognized invocation: %s\n' "$orig_args" >&2
    exit 1
    ;;
esac
